generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Concert {
  id          Int       @id @default(autoincrement())
  title       String
  artist      String
  date        String
  time        String
  venue       String
  location    String
  image       String
  status      String
  priceRange  String
  genre       String
  tags        String
  description String
  isFeatured  Boolean   @default(false)
  saleStartAt DateTime?
  zones       Zone[]
  tickets     Ticket[]
  showtimes   Showtime[]
}

model Showtime {
  id          String       @id @default(uuid())
  concert     Concert      @relation(fields: [concertId], references: [id], onDelete: Cascade)
  concertId   Int
  date        String
  time        String
  tickets     Ticket[]
  bookedSeats BookedSeat[]
}

model Zone {
  id          String       @id @default(uuid())
  zoneId      String
  name        String
  price       Int
  color       String
  rows        Int
  cols        Int
  concert     Concert      @relation(fields: [concertId], references: [id], onDelete: Cascade)
  concertId   Int
  bookedSeats BookedSeat[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  fullName  String
  email     String   @unique
  phone     String
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id          Int          @id @default(autoincrement())
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  concert     Concert      @relation(fields: [concertId], references: [id])
  concertId   Int
  showtime    Showtime?    @relation(fields: [showtimeId], references: [id])
  showtimeId  String?
  totalPaid   Int
  status      String       @default("confirmed")
  holderName  String?
  holderEmail String?
  holderPhone String?
  createdAt   DateTime     @default(now())
  bookedSeats BookedSeat[]
}

model BookedSeat {
  id         String    @id @default(uuid())
  ticket     Ticket    @relation(fields: [ticketId], references: [id])
  ticketId   Int
  zone       Zone      @relation(fields: [zoneId], references: [id])
  zoneId     String
  showtime   Showtime? @relation(fields: [showtimeId], references: [id])
  showtimeId String?
  row        Int
  col        Int
}
